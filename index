<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>THE PRICE OF LIGHT // A Pacific Climate Story</title>
<style>

* { margin:0; padding:0; box-sizing:border-box; font-family:'Trebuchet MS','Calibri',sans-serif; }

:root{
  --ink:#191919;
  --paper:#EFEBE0;
  --panel:#FAF7EF;
  --amber:#D68A1E;
  --amberDeep:#A5620A;
  --teal:#1B6B73;
  --tealDeep:#0F484E;
  --red:#B23A2E;
  --grey:#6B665C;
}

html, body{ background:var(--paper); color:var(--ink); scroll-behavior:smooth; }

body{
  background-image:
    linear-gradient(var(--paper) 23px, rgba(25,25,25,0.035) 24px),
    linear-gradient(90deg, var(--paper) 23px, rgba(25,25,25,0.035) 24px);
  background-size:24px 24px;
}

#progress{ position:fixed; top:0; left:0; height:4px; width:0%; background:var(--amber); z-index:200; border-bottom:2px solid var(--ink); }

.wrap{ max-width:1400px; margin:0 auto; padding:0 18px; }

/* ============ HERO ============ */
.hero{
  min-height:100vh;
  display:flex; flex-direction:column; align-items:center; justify-content:center;
  text-align:center; padding:60px 24px; position:relative;
}
.eyebrow{
  display:inline-block; background:var(--amber); color:var(--ink);
  font-weight:700; font-size:0.78em; letter-spacing:3px; padding:5px 12px; margin-bottom:20px;
}
.hero h1{
  font-size:clamp(42px,7vw,86px); letter-spacing:1px; line-height:1.02; color:var(--ink);
  max-width:16ch;
  opacity:0; transform:translateY(20px); animation:rise .8s ease forwards .1s;
}
.hero h1 span{ color:var(--amberDeep); }
.hero p{
  margin-top:20px; font-size:19px; color:var(--grey); max-width:560px; line-height:1.6;
  opacity:0; transform:translateY(20px); animation:rise .8s ease forwards .35s;
}
.scroll-hint{
  margin-top:56px; font-size:12px; letter-spacing:2px; color:var(--grey); font-weight:700;
  opacity:0; animation:rise .8s ease forwards .6s;
}
.scroll-hint::after{
  content:""; display:block; width:2px; height:38px; margin:10px auto 0; background:var(--ink);
  animation:drop 1.8s ease-in-out infinite;
}
@keyframes rise{ to{ opacity:1; transform:translateY(0); } }
@keyframes drop{
  0%{ transform:scaleY(0); transform-origin:top; }
  50%{ transform:scaleY(1); transform-origin:top; }
  50.01%{ transform-origin:bottom; }
  100%{ transform:scaleY(0); transform-origin:bottom; }
}

/* ============ CHAPTER LABEL ============ */
.chapter{ max-width:680px; margin:0 auto; padding:110px 24px 24px; text-align:center; }
.chapter .tag{
  display:inline-block; background:var(--ink); color:var(--amber);
  font-size:12px; letter-spacing:2px; font-weight:700; padding:5px 12px; text-transform:uppercase;
}
.chapter h2{ font-size:clamp(28px,4vw,42px); margin:16px 0; line-height:1.15; }
.chapter p{ font-size:17px; color:var(--grey); line-height:1.65; }

/* ============ VERTICAL STICKY STORY ============ */
.story{ position:relative; }
.sticky{
  position:sticky; top:0; height:100vh;
  display:flex; align-items:center; justify-content:space-around;
  overflow:hidden; gap:30px; padding:0 24px;
}

.panel{
  background:var(--panel); border:3px solid var(--ink);
  box-shadow:8px 8px 0 rgba(25,25,25,0.85);
  padding:20px 22px 14px;
}
.panel.chartPanel{ width:50%; max-width:600px; }
.panel .frame-label{
  display:flex; justify-content:space-between; font-size:11px; font-weight:700;
  letter-spacing:0.5px; text-transform:uppercase; color:var(--grey); margin-bottom:10px;
  border-bottom:2px solid var(--ink); padding-bottom:8px;
}
svg{ width:100%; height:auto; display:block; overflow:visible; }

.graph-line{ fill:none; stroke-width:4; stroke-linecap:round; stroke-linejoin:round; transition:stroke-dashoffset .15s linear; }
.axis-line{ stroke:var(--ink); stroke-width:1.5; }
.gridline{ stroke:rgba(25,25,25,0.1); stroke-dasharray:2 4; }
.axis-text{ font-size:10px; fill:var(--grey); font-weight:700; }

.marker{ opacity:0; transition:opacity .35s ease; }
.marker.show{ opacity:1; }
.marker-dot{ r:5; stroke:var(--panel); stroke-width:2; }
.marker-val{ font-size:12px; font-weight:700; text-anchor:middle; }

.bar{ transition:y .5s ease, height .5s ease; }
.bar-label{ font-size:11px; fill:var(--ink); text-anchor:middle; font-weight:700; }
.bar-value{ font-size:11.5px; fill:var(--ink); font-weight:700; text-anchor:middle; opacity:0; transition:opacity .35s ease; }
.bar-value.show{ opacity:1; }

/* text steps */
.text-area{ width:38%; max-width:420px; min-height:300px; position:relative; }
.step{
  position:absolute; top:0; left:0; right:0; opacity:0; transform:translateY(32px);
  transition:opacity .5s ease, transform .5s ease;
}
.step.active{ opacity:1; transform:translateY(0); }
.step .tag{
  display:inline-block; background:var(--amber); color:var(--ink); font-size:12px; font-weight:700;
  letter-spacing:1px; padding:3px 9px; text-transform:uppercase;
}
.step h3{ font-size:34px; margin:12px 0 12px; line-height:1.1; }
.step p{ font-size:16.5px; line-height:1.65; color:var(--ink); margin:0; }
.step .stat{ font-size:24px; font-weight:700; color:var(--red); margin-top:12px; }
.step .stat span{ font-size:12.5px; color:var(--grey); font-weight:normal; margin-left:6px; }

.progress-rail{ position:absolute; left:10px; top:50%; transform:translateY(-50%); display:flex; flex-direction:column; gap:8px; }
.progress-rail .dot{ width:8px; height:8px; background:var(--panel); border:2px solid var(--ink); transition:background .3s; }
.progress-rail .dot.active{ background:var(--amber); }

@media (max-width:900px){
  .sticky{ flex-direction:column; justify-content:center; padding-top:60px; }
  .panel.chartPanel, .text-area{ width:92%; max-width:480px; }
  .text-area{ min-height:220px; }
  .progress-rail{ display:none; }
}

/* ============ HORIZONTAL SCROLL CHAPTER ============ */
.hscroll-outer{ position:relative; height:340vh; }
.hscroll-sticky{
  position:sticky; top:0; height:100vh; overflow:hidden;
  display:flex; flex-direction:column; justify-content:center;
}
.hscroll-track{
  display:flex; gap:26px; padding:0 6vw; will-change:transform;
}
.hcard{
  flex:0 0 auto; width:min(78vw,420px);
  background:var(--panel); border:3px solid var(--ink);
  box-shadow:8px 8px 0 rgba(25,25,25,0.85);
  padding:26px 24px;
}
.hcard .tag{
  display:inline-block; background:var(--ink); color:var(--amber); font-size:11px; font-weight:700;
  letter-spacing:1.5px; padding:4px 10px; text-transform:uppercase; margin-bottom:14px;
}
.hcard h3{ font-size:26px; margin-bottom:10px; }
.hcard .figure{ font-size:40px; font-weight:700; color:var(--tealDeep); margin:8px 0; }
.hcard .figure span{ font-size:14px; color:var(--grey); font-weight:normal; display:block; margin-top:4px; }
.hcard p{ font-size:15px; color:var(--ink); line-height:1.6; }
.hcard.warn .figure{ color:var(--red); }
.hcard-bar{ height:14px; background:var(--paper); border:2px solid var(--ink); margin:14px 0; position:relative; overflow:hidden; }
.hcard-bar-fill{ height:100%; background:var(--teal); transition:width 1s ease; }
.hcard.warn .hcard-bar-fill{ background:var(--red); }

.hscroll-heading{
  text-align:center; margin-bottom:30px; padding:0 24px;
}
.hscroll-heading .tag{
  display:inline-block; background:var(--ink); color:var(--amber);
  font-size:12px; letter-spacing:2px; font-weight:700; padding:5px 12px; text-transform:uppercase;
}
.hscroll-heading h2{ font-size:clamp(26px,4vw,38px); margin:16px 0 8px; }
.hscroll-heading p{ font-size:15px; color:var(--grey); max-width:520px; margin:0 auto; }

.hscroll-hint{
  text-align:center; font-size:11px; letter-spacing:1.5px; color:var(--grey); font-weight:700;
  margin-top:20px; text-transform:uppercase;
}
.hscroll-progress{
  width:200px; height:4px; background:var(--paper); border:2px solid var(--ink); margin:10px auto 0; overflow:hidden;
}
.hscroll-progress-fill{ height:100%; background:var(--amber); width:0%; }

/* ============ ENDING ============ */
.end{
  min-height:100vh; display:grid; place-items:center; text-align:center;
  background:var(--ink); color:var(--paper); padding:110px 24px;
  border-top:4px solid var(--amberDeep);
}
.end .tag{
  display:inline-block; background:var(--amber); color:var(--ink); font-size:12px; font-weight:700;
  letter-spacing:2px; padding:5px 12px; text-transform:uppercase; margin-bottom:20px;
}
.end h2{ font-size:clamp(32px,5vw,54px); margin:0 0 16px; max-width:18ch; margin-left:auto; margin-right:auto; }
.end p{ font-size:18px; color:#CFC9B8; max-width:560px; margin:0 auto; line-height:1.65; }
.end .stats{ display:flex; gap:20px; justify-content:center; flex-wrap:wrap; margin-top:60px; }
.end .stat-box{
  border:2px solid var(--amber); padding:16px 20px; text-align:left; min-width:170px;
}
.end .stat-box .n{ font-size:32px; font-weight:700; color:var(--amber); display:block; }
.end .stat-box .l{ font-size:12px; letter-spacing:0.5px; color:#CFC9B8; text-transform:uppercase; margin-top:6px; max-width:16ch; }

/* ============ CREDITS ============ */
.credits{ padding:50px 24px 80px; text-align:center; font-size:13px; color:var(--grey); max-width:660px; margin:0 auto; line-height:1.9; }
.credits a{ color:var(--tealDeep); text-decoration:none; font-weight:700; }
.credits a:hover{ text-decoration:underline; }

@media (prefers-reduced-motion:reduce){ *{ animation:none !important; transition:none !important; } }
</style>
</head>
<body>

<div id="progress"></div>

<!-- HERO -->
<section class="hero">
  <div class="eyebrow">A PACIFIC CLIMATE STORY</div>
  <h1>The price of <span>light</span></h1>
  <p>Every switch flipped on in the Pacific comes from somewhere. This is the story of who burns the fuel, who breathes the exhaust, and who pays for the tide it brings.</p>
  <div class="scroll-hint">SCROLL TO BEGIN</div>
</section>

<!-- CHAPTER 1: FIJI LINE (vertical sticky) -->
<div class="chapter">
  <div class="tag">Chapter One</div>
  <h2>Fiji's grid, 2000 – 2023</h2>
  <p>A single diesel generator once kept a coastal village awake after dark. Today the whole grid runs harder to keep up with modern life.</p>
</div>

<section class="story" id="story1" style="height:400vh;">
  <div class="sticky">
    <div class="progress-rail" id="rail1"><div class="dot"></div><div class="dot"></div><div class="dot"></div><div class="dot"></div></div>
    <div class="panel chartPanel">
      <div class="frame-label"><span>FIJI · ELECTRICITY GENERATED</span><span>GWh</span></div>
      <svg id="chart1" viewBox="0 0 500 340"></svg>
    </div>
    <div class="text-area" id="text1">
      <div class="step" data-i="0">
        <div class="tag">2000</div>
        <h3>673 GWh</h3>
        <p>Fiji generates about 673 gigawatt-hours a year — enough for radios, a few fridges, and streetlights in town.</p>
      </div>
      <div class="step" data-i="1">
        <div class="tag">2010</div>
        <h3>958 GWh</h3>
        <p>Demand climbs nearly 40% in a decade as tourism grows along the Coral Coast and diesel plants run longer hours.</p>
      </div>
      <div class="step" data-i="2">
        <div class="tag">2019</div>
        <h3>1,228 GWh</h3>
        <p>Growth keeps outrunning the grid's cleanest options — most new demand is still met by fuel shipped in by sea.</p>
      </div>
      <div class="step" data-i="3">
        <div class="tag">2023</div>
        <h3>1,285 GWh</h3>
        <p>Almost double the year-2000 figure — the most linear growth curve of any Pacific economy.</p>
        <div class="stat">+91% <span>since 2000, R² = 0.94</span></div>
      </div>
    </div>
  </div>
</section>

<!-- CHAPTER 2: HORIZONTAL SCROLL FILMSTRIP -->
<section class="hscroll-outer" id="hstory">
  <div class="hscroll-sticky">
    <div class="hscroll-heading">
      <div class="tag">Chapter Two</div>
      <h2>Six economies, one direction</h2>
      <p>Scroll down to move sideways through the region — from the fastest-growing grid to the only one shrinking.</p>
    </div>
    <div class="hscroll-track" id="htrack">
      <div class="hcard">
        <div class="tag">New Caledonia</div>
        <h3>The fastest riser</h3>
        <div class="figure">+87.4 <span>GWh added every year — the steepest slope in the region</span></div>
        <div class="hcard-bar"><div class="hcard-bar-fill" style="width:100%; background:var(--amberDeep);"></div></div>
        <p>Nickel processing pushes this grid up faster than anywhere else in the Pacific — output nearly doubled since 2000.</p>
      </div>
      <div class="hcard">
        <div class="tag">Papua New Guinea</div>
        <h3>The biggest grid</h3>
        <div class="figure">2,842 <span>GWh in 2023 — more than every other PICT combined</span></div>
        <div class="hcard-bar"><div class="hcard-bar-fill" style="width:82%;"></div></div>
        <p>Mining and gas exports drive huge swings in demand across the country's scattered island grids.</p>
      </div>
      <div class="hcard">
        <div class="tag">Fiji</div>
        <h3>The steadiest climb</h3>
        <div class="figure">+22.8 <span>GWh a year, R² = 0.94 — the most predictable trend of any island</span></div>
        <div class="hcard-bar"><div class="hcard-bar-fill" style="width:65%;"></div></div>
        <p>Tourism and household demand pull the grid upward in an almost perfectly straight line, year after year.</p>
      </div>
      <div class="hcard">
        <div class="tag">Samoa</div>
        <h3>Small island, big jump</h3>
        <div class="figure">+129% <span>growth since 2000, on a much smaller base</span></div>
        <div class="hcard-bar"><div class="hcard-bar-fill" style="width:55%;"></div></div>
        <p>A fast-growing tourism economy on Upolu and Savai'i has more than doubled the demand on the grid.</p>
      </div>
      <div class="hcard">
        <div class="tag">Solomon Islands</div>
        <h3>Growth without reach</h3>
        <div class="figure">+85% <span>since 2000, even as much of the country waits for a first connection</span></div>
        <div class="hcard-bar"><div class="hcard-bar-fill" style="width:48%;"></div></div>
        <p>Honiara's grid nearly doubled, but growth on paper doesn't always mean growth in access.</p>
      </div>
      <div class="hcard warn">
        <div class="tag">Guam — the exception</div>
        <h3>The only grid shrinking</h3>
        <div class="figure">−4.6 <span>GWh a year — the sole major producer in decline</span></div>
        <div class="hcard-bar"><div class="hcard-bar-fill" style="width:30%;"></div></div>
        <p>While the rest of the region climbs, Guam's output has quietly eased back for two decades.</p>
      </div>
    </div>
    <div class="hscroll-hint">KEEP SCROLLING ↓
      <div class="hscroll-progress"><div class="hscroll-progress-fill" id="hfill"></div></div>
    </div>
  </div>
</section>

<!-- CHAPTER 3: GHG BAR (vertical sticky) -->
<div class="chapter">
  <div class="tag">Chapter Three</div>
  <h2>Rising demand isn't rising blame</h2>
  <p>Measured per person, the story flips — the islands burning the most fuel to keep the lights on often contributed least to the warming now reaching their shores.</p>
</div>

<section class="story" id="story3" style="height:400vh;">
  <div class="sticky">
    <div class="progress-rail" id="rail3"><div class="dot"></div><div class="dot"></div><div class="dot"></div><div class="dot"></div></div>
    <div class="panel chartPanel">
      <div class="frame-label"><span>GHG EMISSIONS PER PERSON</span><span>tonnes</span></div>
      <svg id="chart3" viewBox="0 0 500 340"></svg>
    </div>
    <div class="text-area" id="text3">
      <div class="step" data-i="0">
        <div class="tag">Tuvalu & Kiribati</div>
        <h3>Under 1 tonne</h3>
        <p>Tuvalu emits about 0.4 tonnes of greenhouse gas per person a year — among the lowest on Earth. Its highest point is roughly four metres above sea level.</p>
      </div>
      <div class="step" data-i="1">
        <div class="tag">Fiji & Samoa</div>
        <h3>2 – 3 tonnes</h3>
        <p>A fraction of the world average, yet these islands face some of the region's most severe cyclones and coastal erosion.</p>
      </div>
      <div class="step" data-i="2">
        <div class="tag">New Caledonia</div>
        <h3>13.2 tonnes, rising</h3>
        <p>Nickel processing pushes per-person emissions far above its neighbours — still climbing, +0.14 t every year, the steepest rise of any PICT.</p>
      </div>
      <div class="step" data-i="3">
        <div class="tag">Palau — the outlier</div>
        <h3>132 tonnes, on average</h3>
        <p>Real, but misleading alone — much of that fuel is sold to passing ships and aircraft, not burned by residents.</p>
      </div>
    </div>
  </div>
</section>

<!-- END -->
<section class="end">
  <div>
    <div class="tag">Closing</div>
    <h2>The tide doesn't check who caused it</h2>
    <p>Island nations are modernising fast, mostly on imported fuel, while carrying a share of climate risk far larger than their share of the problem.</p>
    <div class="stats">
      <div class="stat-box"><span class="n">+155</span><span class="l">GWh added to the region's grid every year, on average</span></div>
      <div class="stat-box"><span class="n">0.4t</span><span class="l">Tuvalu's per-person emissions — among the world's lowest</span></div>
      <div class="stat-box"><span class="n">4m</span><span class="l">Tuvalu's highest elevation above sea level</span></div>
    </div>
  </div>
</section>

<div class="credits">
  Every chart here is hand-built with inline SVG bound directly to Pacific climate data, animated on scroll with no chart library — kept dependency-free so it renders instantly, everywhere.<br><br>
  Data: Pacific Community (SPC) Pacific Data Hub, "Climate Change Indicators" data flow (SPC_DF_CLIMATE_CHANGE_1.0) — Power generation (GWh, 2000–2023) and Greenhouse gas emissions per capita (tonnes, 1970–2024). Trend figures from accompanying OLS regression analysis. Palau and New Caledonia figures reflect national reporting methods that can include fuel re-exported for international shipping and aviation.
</div>

<script>
const YEARS = [2000,2001,2002,2003,2004,2005,2006,2007,2008,2009,2010,2011,2012,2013,2014,2015,2016,2017,2018,2019,2020,2021,2022,2023];
const FIJI = [673.4,706.7,767.4,777.9,809.1,841.9,902.7,909.2,914.6,905.0,957.8,931.2,920.7,969.3,995.0,1019.3,1030.5,1112.6,1140.3,1227.8,1141.9,1094.9,1245.6,1284.5];

const GHG = [
  { name:"Tuvalu", value:0.4 },
  { name:"Kiribati", value:0.9 },
  { name:"Fiji", value:3.0 },
  { name:"Samoa", value:2.4 },
  { name:"New Caledonia", value:13.2 },
  { name:"Palau", value:131.9, broken:true }
];

const NS = "http://www.w3.org/2000/svg";
function el(tag, attrs){ const e=document.createElementNS(NS,tag); for(const k in attrs) e.setAttribute(k,attrs[k]); return e; }

/* ---------- Chart 1: Fiji line ---------- */
function buildChart1(){
  const svg = document.getElementById("chart1");
  const W=500,H=340,padL=46,padR=16,padT=16,padB=30;
  const xMin=2000,xMax=2023,yMax=1400;
  const x = yr => padL + (W-padL-padR)*((yr-xMin)/(xMax-xMin));
  const y = v => H-padB - (H-padB-padT)*(v/yMax);

  svg.appendChild(el("line",{class:"axis-line",x1:padL,y1:H-padB,x2:W-padR,y2:H-padB}));
  svg.appendChild(el("line",{class:"axis-line",x1:padL,y1:padT,x2:padL,y2:H-padB}));
  [0,700,1400].forEach(v=>{
    svg.appendChild(el("line",{class:"gridline",x1:padL,y1:y(v),x2:W-padR,y2:y(v)}));
    const t=el("text",{class:"axis-text",x:padL-6,y:y(v)+3,"text-anchor":"end"}); t.textContent=v; svg.appendChild(t);
  });
  [2000,2010,2019,2023].forEach(yr=>{
    const t=el("text",{class:"axis-text",x:x(yr),y:H-padB+16,"text-anchor":"middle"}); t.textContent=yr; svg.appendChild(t);
  });

  const pts = FIJI.map((v,i)=>`${x(YEARS[i]).toFixed(1)},${y(v).toFixed(1)}`).join(" ");
  const path = el("polyline",{class:"graph-line",points:pts,stroke:"#A5620A"});
  svg.appendChild(path);

  const markYears=[2000,2010,2019,2023];
  const markers = markYears.map((yr,k)=>{
    const idx = YEARS.indexOf(yr);
    const dot = el("circle",{class:"marker marker-dot",id:"m1-"+k,cx:x(yr),cy:y(FIJI[idx]),fill:"#191919"});
    const val = el("text",{class:"marker marker-val",id:"mv1-"+k,x:x(yr),y:y(FIJI[idx])-14,fill:"#191919"});
    val.textContent = FIJI[idx].toFixed(0);
    svg.appendChild(dot); svg.appendChild(val);
    return {dot,val};
  });

  return {path,markers};
}
function updateChart1(state,progress,stepIndex){
  const len=1600;
  state.path.setAttribute("stroke-dasharray",len);
  state.path.setAttribute("stroke-dashoffset",len*(1-progress));
  state.markers.forEach((m,k)=>{
    const show = k<=stepIndex;
    m.dot.classList.toggle("show",show);
    m.val.classList.toggle("show",show);
  });
}

/* ---------- Chart 3: GHG bars ---------- */
function buildChart3(){
  const svg = document.getElementById("chart3");
  const W=500,H=340,padL=20,padR=20,padT=30,padB=46;
  const cap=20;
  const n=GHG.length, gap=14;
  const barW=(W-padL-padR-gap*(n-1))/n;
  const chartBottom=H-padB, chartTop=padT;
  const scaleH = v => (Math.min(v,cap)/cap)*(chartBottom-chartTop);

  svg.appendChild(el("line",{class:"axis-line",x1:padL,y1:chartBottom,x2:W-padR,y2:chartBottom}));

  const bars = GHG.map((d,i)=>{
    const bx = padL + i*(barW+gap);
    const h = scaleH(d.value);
    const yTop = chartBottom - h;
    const color = d.broken ? "#B23A2E" : (d.value>8 ? "#D68A1E" : "#1B6B73");

    const rect = el("rect",{class:"bar",id:"bar3-"+i,x:bx.toFixed(1),y:chartBottom,width:barW.toFixed(1),height:0,fill:color,stroke:"#191919","stroke-width":2});
    svg.appendChild(rect);

    if(d.broken){
      const pts = `${bx},${yTop} ${bx+barW*0.2},${yTop-8} ${bx+barW*0.4},${yTop+4} ${bx+barW*0.6},${yTop-10} ${bx+barW*0.8},${yTop+3} ${bx+barW},${yTop-6}`;
      svg.appendChild(el("polyline",{points:pts,fill:"none",stroke:"#191919","stroke-width":2}));
    }

    const val = el("text",{class:"bar-value",id:"bv3-"+i,x:bx+barW/2,y:yTop-10});
    val.textContent = (d.broken?"~"+d.value.toFixed(0):d.value)+"t";
    svg.appendChild(val);

    const lbl = el("text",{class:"bar-label",x:bx+barW/2,y:chartBottom+18});
    lbl.textContent = d.name;
    svg.appendChild(lbl);

    return {rect,val,yTop,h};
  });

  return {bars,chartBottom};
}
function updateChart3(state,stepIndex){
  const reveal = [2,4,5,6][stepIndex]||6;
  state.bars.forEach((b,i)=>{
    if(i<reveal){
      b.rect.setAttribute("y",b.yTop);
      b.rect.setAttribute("height",b.h);
      b.val.classList.add("show");
    } else {
      b.rect.setAttribute("y",state.chartBottom);
      b.rect.setAttribute("height",0);
      b.val.classList.remove("show");
    }
  });
}

/* ---------- vertical sticky engine ---------- */
function setupStory(storyId,textId,railId,stepCount,onUpdate){
  const story = document.getElementById(storyId);
  const steps = document.querySelectorAll("#"+textId+" .step");
  const railDots = railId ? document.querySelectorAll("#"+railId+" .dot") : [];

  function update(){
    const rect = story.getBoundingClientRect();
    const total = story.offsetHeight - window.innerHeight;
    const raw = -rect.top/(total||1);
    const clamped = Math.max(0,Math.min(0.9999,raw));
    const stepFloat = clamped*stepCount;
    const stepIndex = Math.min(stepCount-1,Math.floor(stepFloat));
    const stepProgress = stepFloat - stepIndex;

    steps.forEach((s,i)=>s.classList.toggle("active",i===stepIndex));
    railDots.forEach((d,i)=>d.classList.toggle("active",i===stepIndex));
    onUpdate(clamped,stepIndex,stepProgress);
  }
  let ticking=false;
  window.addEventListener("scroll",()=>{
    if(!ticking){ requestAnimationFrame(()=>{update(); ticking=false;}); ticking=true; }
  });
  update();
}

/* ---------- horizontal scroll engine ---------- */
function setupHScroll(outerId, trackId, fillId){
  const outer = document.getElementById(outerId);
  const track = document.getElementById(trackId);
  const fill = document.getElementById(fillId);

  function update(){
    const rect = outer.getBoundingClientRect();
    const total = outer.offsetHeight - window.innerHeight;
    const raw = -rect.top/(total||1);
    const clamped = Math.max(0,Math.min(1,raw));
    const maxScroll = Math.max(0, track.scrollWidth - track.parentElement.clientWidth + 40);
    track.style.transform = `translateX(-${clamped*maxScroll}px)`;
    if(fill) fill.style.width = (clamped*100)+"%";
  }
  let ticking=false;
  window.addEventListener("scroll",()=>{
    if(!ticking){ requestAnimationFrame(()=>{update(); ticking=false;}); ticking=true; }
  });
  window.addEventListener("resize", update);
  update();
}

function updateProgressBar(){
  const doc = document.documentElement;
  const scrolled = (doc.scrollTop)/(doc.scrollHeight-doc.clientHeight)*100;
  document.getElementById("progress").style.width = scrolled+"%";
}

window.addEventListener("load", ()=>{
  const c1 = buildChart1();
  const c3 = buildChart3();

  setupStory("story1","text1","rail1",4,(clamped,stepIndex)=>updateChart1(c1,clamped,stepIndex));
  setupStory("story3","text3","rail3",4,(clamped,stepIndex)=>updateChart3(c3,stepIndex));
  setupHScroll("hstory","htrack","hfill");

  window.addEventListener("scroll", updateProgressBar);
  updateProgressBar();
});
</script>

