let notebookLog = [];
let current = 'n1';

const speakerEl = document.getElementById('speaker');
const dialogueEl = document.getElementById('dialogueText');
const choicesEl = document.getElementById('choices');
const advanceHint = document.getElementById('advanceHint');
const portraitLeft = document.getElementById('portraitLeft');
const portraitRight = document.getElementById('portraitRight');
const dataCard = document.getElementById('dataCard');
const dataCardBody = document.getElementById('dataCardBody');
const chapterLabel = document.getElementById('chapterLabel');
const logCount = document.getElementById('logCount');

function startGame(){
  document.getElementById('boot').classList.remove('active');
  document.getElementById('vn').classList.add('active');
  render('n1');
}

function render(id){
  if(id === 'END'){ showEnd(); return; }
  const node = nodes[id];
  if(!node){ console.error('missing node', id); return; }
  current = id;
  dataCard.classList.remove('show');
  if(node.chapter){ chapterLabel.textContent = node.chapter; }

  if(node.sp === 'sup'){
    speakerEl.textContent = node.name;
    portraitLeft.classList.add('show');
    portraitRight.classList.remove('show');
  } else if(node.sp === 'ana'){
    speakerEl.textContent = node.name;
    portraitRight.classList.add('show');
    portraitLeft.classList.remove('show');
  } else {
    speakerEl.textContent = node.name;
    portraitLeft.classList.remove('show');
    portraitRight.classList.remove('show');
  }

  if(node.choice){
    dialogueEl.textContent = node.prompt || "";
    advanceHint.style.display = 'none';
    choicesEl.innerHTML = '';
    choicesEl.classList.add('active');
    node.options.forEach(opt=>{
      const b = document.createElement('button');
      b.className = 'choiceBtn';
      b.textContent = opt.label;
      b.onclick = (e)=>{
        e.stopPropagation();
        choicesEl.classList.remove('active');
        if(opt.log) addLog(opt.log);
        render(opt.next);
      };
      choicesEl.appendChild(b);
    });
  } else {
    choicesEl.classList.remove('active');
    advanceHint.style.display = 'block';
    dialogueEl.textContent = node.text;
    if(node.data){
      dataCardBody.innerHTML = '';
      dataCard.querySelector('.title').textContent = node.data.title;
      node.data.rows.forEach(r=>{
        const row = document.createElement('div');
        row.className = 'row';
        row.innerHTML = '<span>'+r[0]+'</span><span>'+r[1]+'</span>';
        dataCardBody.appendChild(row);
      });
      dataCard.classList.add('show');
    }
    if(node.log){ addLog(node.log); }
  }
}

function advance(){
  const node = nodes[current];
  if(!node || node.choice) return;
  if(node.next) render(node.next);
}

function addLog(entry){
  if(notebookLog.find(l=>l.title===entry.title)) return;
  notebookLog.push(entry);
  logCount.textContent = '['+notebookLog.length+']';
  renderNotebook();
}

function renderNotebook(){
  const body = document.getElementById('notebookBody');
  if(notebookLog.length===0){
    body.innerHTML = '<div class="empty">No evidence logged yet. Keep investigating.</div>';
    return;
  }
  body.innerHTML = '';
  notebookLog.forEach(entry=>{
    const div = document.createElement('div');
    div.className = 'entry';
    const t = document.createElement('div');
    t.className = 't';
    t.textContent = entry.title;
    div.appendChild(t);
    entry.rows.forEach(r=>{
      const row = document.createElement('div');
      row.className = 'row';
      row.innerHTML = '<span>'+r[0]+'</span><span>'+r[1]+'</span>';
      div.appendChild(row);
    });
    body.appendChild(div);
  });
}

function toggleNotebook(show){
  const nb = document.getElementById('notebook');
  if(show){ renderNotebook(); nb.classList.add('show'); }
  else { nb.classList.remove('show'); }
}

function showEnd(){
  document.getElementById('vn').classList.remove('active');
  document.getElementById('endScreen').classList.add('active');
  document.getElementById('endBody').innerHTML =
    '<p style="text-align:center;color:#fff;">CASE FILE PROJECT 0.18 \u2014 CLOSED</p>' +
    '<h3>MAIN FINDING</h3>' +
    '<p>Increasing electricity generation does not necessarily increase greenhouse gas emissions. The correlation between generation growth and per-capita emissions growth was weak and statistically insignificant (r = 0.18, p = 0.53). Emissions are shaped far more by fuel mix, industrial activity, population, and country-specific characteristics \u2014 and by Palau\u2019s outsized reduction skewing the regional average.</p>' +
    '<h3>WHAT SHOULD BE DONE</h3>' +
    '<ol>' +
      '<li><b>Transition to cleaner energy.</b> Volume isn\u2019t the driver \u2014 composition is. Keep expanding electricity access, but grow the renewable share of the mix.</li>' +
      '<li><b>Adopt country-specific policy.</b> Understand and stabilize Palau\u2019s outlier drop, actively manage New Caledonia\u2019s industrial growth, and support the rest of the region in holding its already-low baseline.</li>' +
      '<li><b>Improve data collection.</b> Add population detail, fuel-mix breakdowns, renewable-energy shares, and finer time resolution so future models are sharper than this one.</li>' +
      '<li><b>Continue monitoring.</b> The forecast \u2014 electricity toward ~11,960 GWh by 2028, per-capita emissions toward ~5.8 tonnes by 2029 \u2014 is a positive but simple linear projection. Re-check it as real data arrives; don\u2019t treat it as finished.</li>' +
    '</ol>' +
    '<h3>CLOSING NOTE</h3>' +
    '<p>The real challenge was never how much electricity gets produced. It\u2019s how that electricity gets produced \u2014 and whether anyone keeps watching after the report ships.</p>';
}
