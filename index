<script>
/* ================= BOOT ================= */
const bootLinesEl = document.getElementById('bootLines');
function typeBootLine(text, cb, speed=16){
  let i = 0;
  const span = document.createElement('div');
  bootLinesEl.appendChild(span);
  const t = setInterval(()=>{
    span.textContent = text.slice(0,i+1);
    i++;
    if(i>=text.length){ clearInterval(t); cb && cb(); }
  }, speed);
}
function runBoot(){
  typeBootLine("PACIFIC ENERGY MONITOR", ()=>{
    typeBootLine("", ()=>{
      typeBootLine("Loading regional datasets 2013-2023...", ()=>{ setTimeout(loadBar, 250); });
    });
  });
}
function loadBar(){
  const barDiv = document.createElement('div');
  bootLinesEl.appendChild(barDiv);
  let n = 0; const total = 24;
  const t = setInterval(()=>{
    n++;
    barDiv.textContent = "\u2588".repeat(n) + " " + Math.min(100, Math.round(n/total*100)) + "%";
    if(n>=total){
      clearInterval(t);
      setTimeout(()=>{
        const g = document.createElement('div');
        g.textContent = "\nACCESS GRANTED";
        g.style.marginTop = "8px";
        bootLinesEl.appendChild(g);
        setTimeout(()=>{
          const msg = document.createElement('div');
          msg.style.marginTop = "14px";
          msg.style.color = "#dcefdc";
          msg.textContent = "An encrypted channel opens.\n\nSUPERVISOR: Morning. We've flagged something odd\nin the regional energy figures. Electricity\ngeneration keeps climbing across the islands, but\nthe emissions numbers aren't moving the way they\nshould.\n\nSUPERVISOR: I need someone to actually read the\ndata before we write the headline. That's you.\nCase file PROJECT 0.18 is open.";
          bootLinesEl.appendChild(msg);
          document.getElementById('startBtn').style.display = 'inline-block';
        }, 450);
      }, 350);
    }
  }, 50);
}
runBoot();

/* ================= STORY GRAPH (id-based, bug-safe) ================= */
